import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme/theme.slint";
import { Button, Field, Modal } from "../primitives/modal.slint";

export component AssistantDialog inherits Modal {
    in-out property <bool> chatgpt;
    in property <bool> signed-in;
    in property <string> account-status;
    in-out property <string> endpoint;
    in-out property <string> model;
    in-out property <string> api-key;
    in-out property <string> prompt;
    in property <string> reply;
    in property <bool> busy;
    in property <bool> can-apply;
    callback ask();
    callback apply-plan();
    callback login();
    callback logout();
    callback cancel();
    title: "Assistente de edição";
    surface-width: 640px;
    surface-height: 680px;
    dismissable: !root.busy;
    VerticalLayout {
        padding: 20px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Button { label: "Conta ChatGPT"; primary: root.chatgpt; enabled: !root.busy; clicked => { root.chatgpt = true; } }
            Button { label: "API / Ollama"; primary: !root.chatgpt; enabled: !root.busy; clicked => { root.chatgpt = false; } }
        }
        if root.chatgpt: VerticalLayout {
            spacing: 8px;
            Text { text: "Use o Codex incluído no seu plano ChatGPT. Sem chave de API e sujeito aos limites da assinatura."; wrap: word-wrap; color: Theme.fg; }
            Text { text: root.account-status; wrap: word-wrap; color: Theme.fg-muted; font-size: Theme.fs-sm; }
            Button {
                label: root.signed-in ? "Sair da conta" : "Entrar com ChatGPT";
                enabled: !root.busy;
                clicked => { if root.signed-in { root.logout(); } else { root.login(); } }
            }
        }
        if !root.chatgpt: VerticalLayout {
            spacing: 8px;
            Text { text: "API com cobrança separada ou Ollama local"; color: Theme.fg; }
            Field { value: root.endpoint; edited(text) => { root.endpoint = text; } }
            HorizontalLayout {
                spacing: 8px;
                Field { value: root.model; placeholder: "Modelo"; edited(text) => { root.model = text; } }
                Field { value: root.api-key; secret: true; placeholder: "Chave de API (só nesta sessão)"; edited(text) => { root.api-key = text; } }
            }
        }
        Text {
            text: "Ao enviar, os metadados do projeto (incluindo nomes e caminhos) serão enviados ao serviço escolhido. Arquivos de mídia não são enviados.";
            wrap: word-wrap; color: Theme.fg-muted; font-size: Theme.fs-sm;
        }
        Field { value: root.prompt; placeholder: "Ex.: adicione um título de abertura por 3 segundos"; edited(text) => { root.prompt = text; } }
        HorizontalLayout {
            spacing: 8px;
            Button { label: root.busy ? "Aguarde…" : "Enviar pedido"; enabled: !root.busy && root.prompt != "" && (!root.chatgpt || root.signed-in); primary: true; clicked => { root.ask(); } }
            if root.chatgpt && root.busy: Button { label: "Cancelar"; clicked => { root.cancel(); } }
        }
        ScrollView { vertical-stretch: 1; Text { text: root.reply; color: Theme.fg; wrap: word-wrap; } }
        Text { text: "Revise a proposta. Aplicar cria uma única edição, que pode ser desfeita com Ctrl+Z."; wrap: word-wrap; color: Theme.fg-muted; font-size: Theme.fs-sm; }
        Button { label: "Aplicar proposta"; primary: true; enabled: root.can-apply && !root.busy; clicked => { root.apply-plan(); } }
    }
}
